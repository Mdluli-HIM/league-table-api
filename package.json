{
  "name": "league-table-api",
  "version": "1.0.0",
  "description": "API for league standings, clubs, players, fixtures, and results.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "npm run typecheck && npm run lint",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "league",
    "football",
    "fixtures",
    "standings",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.61.0"
  }
}
